# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siapos"

# API
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# Auth.js
AUTH_SECRET="your-auth-secret-here"
AUTH_TRUST_HOST="true"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google OAuth (Untuk Login Masuk dengan Google)
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Google Drive Storage (Untuk Upload File)
GDRIVE_CLIENT_ID="your-gdrive-client-id"
GDRIVE_CLIENT_SECRET="your-gdrive-client-secret"
GDRIVE_REFRESH_TOKEN="your-gdrive-refresh-token"
GOOGLE_DRIVE_FOLDER_ID="your-folder-id"
