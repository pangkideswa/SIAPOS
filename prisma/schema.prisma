// Prisma schema for SIAPOS — Education Operating System
// PostgreSQL provider, Prisma ORM 7 (driver adapter setup)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  GURU
  SISWA
  WALI
}

enum AccountStatus {
  BELUM_AKTIF
  AKTIF
  DIBLOKIR
}

enum MaterialStatus {
  DRAFT
  PUBLISH
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  LATE
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScheduleDay {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

enum NotifikasiTipe {
  MATERI
  TUGAS
  PENILAIAN
  PENGUMUMAN
  SISTEM
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPHA
  TERLAMBAT
}

enum AttendanceSessionStatus {
  SELESAI
  BERLANGSUNG
  BELUM
}

// ============================================================================
// Identity
// ============================================================================

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String?       @unique
  password      String?
  role          Role          @default(SISWA)
  status        AccountStatus @default(BELUM_AKTIF)
  provider      String        @default("email")
  providerId    String?
  image         String?
  emailVerified DateTime?
  username      String?       @unique
  nip           String?       @unique
  nisn          String?       @unique
  avatar        String?
  login_count   Int           @default(0)
  last_login    DateTime?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  teacher       Teacher?
  student       Student?
  announcements Announcement[]
  accounts      Account[]
  sessions      Session[]

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Teacher {
  id                  Int       @id @default(autoincrement())
  user_id             Int?      @unique
  user                User?     @relation(fields: [user_id], references: [id])
  foto                String?
  nama_lengkap        String
  nip                 String    @unique
  nuptk               String?
  jenis_kelamin       String    @default("Laki-laki")
  tempat_lahir        String?
  tanggal_lahir       DateTime?
  no_hp               String?
  email               String    @unique
  alamat              String?
  pendidikan_terakhir String?
  status_kepegawaian  String    @default("Honorer")
  mata_pelajaran      Json?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  classrooms       Classroom[]     @relation("HomeroomTeacher")
  teaching_classes TeachingClass[]

  @@index([user_id])
  @@map("teachers")
}

model Student {
  id                Int            @id @default(autoincrement())
  user_id           Int?           @unique
  user              User?          @relation(fields: [user_id], references: [id])
  foto              String?
  nis               String         @unique
  nisn              String         @unique
  nama_lengkap      String
  jenis_kelamin     String         @default("Laki-laki")
  tempat_lahir      String?
  tanggal_lahir     DateTime?
  agama             String?
  alamat            String?
  jurusan_id        Int?
  jurusan           Jurusan?       @relation(fields: [jurusan_id], references: [id])
  kelas             String?
  tahun_masuk       String?
  tahun_ajaran      String?
  status            String         @default("Aktif")
  nama_ayah         String?
  nama_ibu          String?
  no_hp_ortu        String?
  alamat_ortu       String?
  classroom_id      Int?
  classroom         Classroom?     @relation(fields: [classroom_id], references: [id])
  tahun_akademik_id Int?
  tahun_akademik    TahunAkademik? @relation(fields: [tahun_akademik_id], references: [id])
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  submissions        Submission[]
  nilais             Nilai[]
  attendance_records Attendance[]

  @@index([classroom_id])
  @@index([tahun_akademik_id])
  @@map("students")
}

// ============================================================================
// Academic master data
// ============================================================================

model Jurusan {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  students Student[]

  @@map("jurusans")
}

model Classroom {
  id                  Int      @id @default(autoincrement())
  name                String
  major               String?
  grade_level         String?
  homeroom_teacher_id Int?
  homeroom_teacher    Teacher? @relation("HomeroomTeacher", fields: [homeroom_teacher_id], references: [id])
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  students         Student[]
  teaching_classes TeachingClass[]

  @@index([homeroom_teacher_id])
  @@map("classrooms")
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  teaching_classes TeachingClass[]

  @@map("subjects")
}

model TeachingClass {
  id                Int            @id @default(autoincrement())
  classroom_id      Int?
  classroom         Classroom?     @relation(fields: [classroom_id], references: [id])
  subject_id        Int?
  subject           Subject?       @relation(fields: [subject_id], references: [id])
  teacher_id        Int?
  teacher           Teacher?       @relation(fields: [teacher_id], references: [id])
  guru_nama         String?
  mata_pelajaran    String?
  kelas             String?
  tahun_ajaran      String?
  semester          String?
  status            String         @default("Aktif")
  tahun_akademik_id Int?
  tahun_akademik    TahunAkademik? @relation(fields: [tahun_akademik_id], references: [id])
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  materials           Material[]
  assignments         Assignment[]
  schedules           Schedule[]
  nilais              Nilai[]
  attendance_sessions AttendanceSession[]

  @@index([classroom_id])
  @@index([subject_id])
  @@index([teacher_id])
  @@index([tahun_akademik_id])
  @@map("teaching_classes")
}

// ============================================================================
// Learning content
// ============================================================================

model Material {
  id                Int            @id @default(autoincrement())
  teaching_class_id Int?
  teaching_class    TeachingClass? @relation(fields: [teaching_class_id], references: [id], onDelete: Cascade)
  judul             String
  deskripsi         String?
  guru_nama         String?
  mata_pelajaran    String?
  kelas             String?
  pertemuan         Int?
  jenis_materi      String?
  thumbnail_url     String?
  lampiran          Json?
  video_url         String?
  link_drive        String?
  link_eksternal    String?
  isi_materi        String?
  status            MaterialStatus @default(DRAFT)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  @@index([teaching_class_id])
  @@map("materials")
}

model Assignment {
  id                Int              @id @default(autoincrement())
  teaching_class_id Int?
  teaching_class    TeachingClass?   @relation(fields: [teaching_class_id], references: [id], onDelete: Cascade)
  judul             String
  deskripsi         String?
  guru_nama         String?
  mata_pelajaran    String?
  kelas             String?
  lampiran          Json?
  tanggal_dibuka    DateTime?
  tenggat_waktu     DateTime?
  tenggat_jam       String?
  nilai_maksimal    Int              @default(100)
  status            AssignmentStatus @default(DRAFT)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  submissions Submission[]

  @@index([teaching_class_id])
  @@map("assignments")
}

model Submission {
  id                Int              @id @default(autoincrement())
  assignment_id     Int?
  assignment        Assignment?      @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student_id        Int?
  student           Student?         @relation(fields: [student_id], references: [id], onDelete: Cascade)
  file_jawaban      Json?
  catatan           String?
  waktu_pengumpulan DateTime?
  status            SubmissionStatus @default(NOT_SUBMITTED)
  nilai             Int?
  feedback          String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@index([assignment_id])
  @@index([student_id])
  @@map("submissions")
}

// ============================================================================
// Attendance
// ============================================================================

model AttendanceSession {
  id                Int                     @id @default(autoincrement())
  teaching_class_id Int?
  teaching_class    TeachingClass?          @relation(fields: [teaching_class_id], references: [id], onDelete: SetNull)
  tanggal           DateTime
  jam_mulai         String?
  jam_selesai       String?
  mata_pelajaran    String?
  guru_nama         String?
  kelas             String?
  tahun_ajaran      String?
  semester          String?
  status            AttendanceSessionStatus @default(BELUM)
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  records Attendance[]

  @@index([teaching_class_id])
  @@index([tanggal])
  @@map("attendance_sessions")
}

model Attendance {
  id         Int               @id @default(autoincrement())
  session_id Int
  session    AttendanceSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  student_id Int
  student    Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)
  status     AttendanceStatus  @default(HADIR)
  keterangan String?
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  @@unique([session_id, student_id])
  @@index([student_id])
  @@map("attendance_records")
}

// ============================================================================
// Communication & scheduling
// ============================================================================

model Announcement {
  id              Int                @id @default(autoincrement())
  judul           String
  ringkasan       String?
  isi             String?
  kategori        String?
  target          String?
  kelas           String?
  status          AnnouncementStatus @default(DRAFT)
  penulis         String?
  pinned          Boolean            @default(false)
  lampiran        Json?
  tanggal_publish DateTime?
  author_id       Int?
  author          User?              @relation(fields: [author_id], references: [id])
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt

  @@index([author_id])
  @@index([status])
  @@map("announcements")
}

model Schedule {
  id                Int            @id @default(autoincrement())
  teaching_class_id Int?
  teaching_class    TeachingClass? @relation(fields: [teaching_class_id], references: [id], onDelete: Cascade)
  hari              ScheduleDay
  jam_mulai         String?
  jam_selesai       String?
  mata_pelajaran    String?
  guru_nama         String?
  kelas             String?
  tahun_ajaran      String?
  semester          String?
  ruang             String?
  status            String         @default("Aktif")
  tahun_akademik_id Int?
  tahun_akademik    TahunAkademik? @relation(fields: [tahun_akademik_id], references: [id])
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  @@index([teaching_class_id])
  @@index([hari])
  @@index([tahun_akademik_id])
  @@map("schedules")
}

// ============================================================================
// Academic year & grades
// ============================================================================

enum NilaiStatus {
  LENGKAP
  BELUM_LENGKAP
}

model TahunAkademik {
  id              Int       @id @default(autoincrement())
  nama            String    @unique
  tanggal_mulai   DateTime?
  tanggal_selesai DateTime?
  is_active       Boolean   @default(false)
  keterangan      String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  students         Student[]
  teaching_classes TeachingClass[]
  schedules        Schedule[]
  nilais           Nilai[]

  @@index([is_active])
  @@map("tahun_akademik")
}

model Nilai {
  id                Int            @id @default(autoincrement())
  student_id        Int?
  student           Student?       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teaching_class_id Int?
  teaching_class    TeachingClass? @relation(fields: [teaching_class_id], references: [id], onDelete: Cascade)
  tahun_akademik_id Int?
  tahun_akademik    TahunAkademik? @relation(fields: [tahun_akademik_id], references: [id])
  tugas             Int?
  praktik           Int?
  uts               Int?
  uas               Int?
  nilai_akhir       Int?
  status            NilaiStatus    @default(BELUM_LENGKAP)
  tahun_ajaran      String?
  semester          String?
  keterangan        String?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  @@unique([student_id, teaching_class_id, semester])
  @@index([teaching_class_id])
  @@index([tahun_akademik_id])
  @@map("nilai")
}

// ============================================================================
// Notifications
// ============================================================================

model Notifikasi {
  id          Int            @id @default(autoincrement())
  tipe        NotifikasiTipe
  judul       String
  pesan       String
  href        String?
  targetRoles String[]       @default([])
  is_read     Boolean        @default(false)
  created_at  DateTime       @default(now())

  @@map("notifikasis")
}
